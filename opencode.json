{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trie": {
      "type": "local",
      "command": ["trie", "mcp", "serve"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "lsp": true
}

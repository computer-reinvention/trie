# trie cache
.trie/

# trie telemetry (TRIE_DEBUG)
debug.jsonl
debug.*.jsonl

# opencode plugin install (generated by `trie setup --target opencode`).
# The plugin is bootstrapped per-checkout from the template baked into trie;
# committing the generated TypeScript + its Bun/node_modules tree adds noise
# without adding source-of-truth. `.opencode.bak/` is a local backup of that
# generated tree.
.opencode/
.opencode.bak/

# Claude Code config (created by `trie mcp install --target claude-code`
# or `trie setup --target claude-code --with-mcp`).
.claude/
.mcp.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# venv
.venv/
venv/
env/
ENV/

# uv
.uv/

